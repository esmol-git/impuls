# Скопируйте в корень проекта как .env.deploy:
#   cp deploy/env.example .env.deploy
#
# Затем локально: npm run deploy:all

DEPLOY_HOST=your-server-ip-or-hostname
DEPLOY_USER=root
DEPLOY_PORT=22

# Корень приложения на сервере (код API + .output Nuxt)
DEPLOY_APP_PATH=/opt/impuls

# Статика админки
DEPLOY_ADMIN_PATH=/var/www/admin.impuls.esmolakov.ru

# Публичные URL
NUXT_SITE_URL=https://impuls.esmolakov.ru
ADMIN_SITE_URL=https://admin.impuls.esmolakov.ru

# Nuxt → Nest на том же сервере (server-side)
NUXT_API_URL=http://127.0.0.1:3001

# ---------------------------------------------------------------------------
# GitHub Actions (.github/workflows/deploy.yml)
# Repo → Settings → Secrets and variables → Actions:
#
#   DEPLOY_HOST     = 185.219.43.126
#   DEPLOY_USER     = root          (опционально, default root)
#   DEPLOY_PORT     = 22            (опционально)
#   DEPLOY_SSH_KEY  = содержимое приватного ключа (весь файл, включая
#                     -----BEGIN OPENSSH PRIVATE KEY----- ... END ...)
#
# Публичный ключ должен быть в /root/.ssh/authorized_keys на сервере.
# Деплой: push в main или Actions → Deploy → Run workflow.
# ---------------------------------------------------------------------------
#
# Обслуживание на сервере (после первого деплоя / вручную):
#   /opt/impuls/deploy/backup-postgres.sh   — дамп Postgres (cron 03:15 UTC, 14 дней)
#   /opt/impuls/deploy/healthcheck.sh      — API+сайт каждые 5 мин, restart при падении
#   /opt/impuls/deploy/harden-ssh.sh       — только SSH-ключи (без пароля)
# ---------------------------------------------------------------------------
