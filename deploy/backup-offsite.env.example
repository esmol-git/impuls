# Скопируйте на сервер:
#   cp deploy/backup-offsite.env.example /opt/impuls-data/backups/offsite.env
#   chmod 600 /opt/impuls-data/backups/offsite.env
#
# Cloudflare → R2 → Create bucket (например impuls-backups)
# Cloudflare → R2 → Manage R2 API Tokens → Create API token
#   Permissions: Object Read & Write (на этот bucket)
# Account ID — на странице R2 Overview справа.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=impuls-backups
# префикс внутри bucket
R2_PREFIX=postgres
# сколько дней хранить на R2 (локально отдельно — KEEP_DAYS в backup-postgres.sh)
R2_KEEP_DAYS=30
