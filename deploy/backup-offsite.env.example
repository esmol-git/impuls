# Опционально. По умолчанию offsite идёт в Telegram через
# /opt/impuls-data/gatus/.env (TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID) — без карты.
#
# R2 — только если когда-нибудь подключите (нужна карта в Cloudflare):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=impuls-backups
# R2_PREFIX=postgres
# R2_KEEP_DAYS=30
#
# Переопределить Telegram (иначе берутся из gatus/.env):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
