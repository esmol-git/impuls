DATABASE_URL=postgresql://impuls:impuls@localhost:5432/impuls?schema=public

# В production обязателен сильный секрет (без fallback)
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3001
NODE_ENV=development

ADMIN_EMAIL=admin@impuls.local
ADMIN_PASSWORD=admin123
# Опционально: сбросить пароль админа при seed (по умолчанию seed пароль НЕ трогает)
# SEED_RESET_ADMIN_PASSWORD=1

UPLOAD_DIR=uploads

# Список origins через запятую (в production обязателен)
# Dev:
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# Prod (оба публичных домена):
# CORS_ORIGIN=https://impuls.esmolakov.ru,https://admin.impuls.esmolakov.ru

# MinIO (S3-compatible). npm run db:up поднимает контейнер.
# В production задайте свои ключи — fallback minioadmin только для dev.
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=impuls
MINIO_REGION=us-east-1
